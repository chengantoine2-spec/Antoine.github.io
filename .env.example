# 站点与数据源（全部可选，缺省值见 src/lib/github.ts）
VITE_GH_USER=YOUR_GITHUB_USER
VITE_GH_REPO=caramel-blog
VITE_GH_OWNER=YOUR_GITHUB_USER
VITE_IMG_BRANCH=img
VITE_SITE_TITLE=焦糖布丁

