# Giscus（https://giscus.app 取 repo-id / category-id）
VITE_GISCUS_REPO=YOUR_GITHUB_USER/caramel-blog
VITE_GISCUS_REPO_ID=TODO_REPO_ID
VITE_GISCUS_CATEGORY=Announcements
