# 站点与数据源：默认值已指向当前仓库（src/lib/github.ts），一般无需设置
# 只有换仓库/改标题时才需要这些变量
VITE_GH_USER=chengantoine2-spec
VITE_GH_REPO=Antoine.github.io
VITE_GH_OWNER=chengantoine2-spec
VITE_IMG_BRANCH=img
VITE_SITE_TITLE=焦糖布丁

# 本地开发用子路径（部署由 workflow 自动注入 /<repo>/）
# VITE_BASE=/Antoine.github.io/

# Giscus：必须填！到 https://giscus.app 取 repo-id / category-id
# 前置条件：仓库 Settings 里开启 Discussions
VITE_GISCUS_REPO=chengantoine2-spec/Antoine.github.io
VITE_GISCUS_REPO_ID=TODO_REPO_ID
VITE_GISCUS_CATEGORY=Announcements
VITE_GISCUS_CATEGORY_ID=TODO_CATEGORY_ID
VITE_GISCUS_MAPPING=pathname
VITE_GISCUS_LANG=zh-CN
