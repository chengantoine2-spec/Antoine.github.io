{
  "name": "desktop-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "term": "node tools/term-server.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build && node tools/pages-postbuild.mjs",
    "verify": "node tools/verify.mjs",
    "verify:dst": "node tools/verify-dst.mjs",
    "verify:tarot": "node tools/verify-tarot.mjs",
    "verify:almanac": "node tools/verify-almanac.mjs",
    "tarot:assets": "python tools/tarot-assets.py",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "6.26.2",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.9"
  }
}
